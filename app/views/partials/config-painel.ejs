
<div class="config<%= classe ? ' ' + classe : '' %>">
    <div class="config-painel" id="config-painel" hidden>
        <h3>Configurações</h3>

        <div class="config-grupo">
            <span>Tamanho da fonte</span>
            <div class="config-linha">
                <button type="button" id="fonte-menos" aria-label="Diminuir fonte">A−</button>
                <div class="config-valor" id="fonte-valor" aria-live="polite">100%</div>
                <button type="button" id="fonte-mais" aria-label="Aumentar fonte">A+</button>
            </div>
        </div>

        <div class="config-grupo">
            <span>Tema</span>
            <div class="config-linha">
                <button type="button" id="tema-claro">☀ Claro</button>
                <button type="button" id="tema-escuro">🌙 Escuro</button>
            </div>
        </div>

        <button type="button" class="config-restaurar" id="config-restaurar">Restaurar padrão</button>
    </div>

    <button type="button" class="config-botao" id="config-abrir" aria-label="Abrir configurações" aria-expanded="false" aria-controls="config-painel">⚙</button>
</div>
