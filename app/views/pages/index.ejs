<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/config.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Conecta Mundos</title>
    <script src="/js/config.js"></script>
</head>

<body>
    <section class="inicio" id="tela-inicio">
        <header>
            <div class="logo">
                <img class="logo-img" src="/imagem/logo_degrade.png" alt="Logo Conecta Mundos">
            </div>
        </header>

        <main>
            <div>
                <h2 class="title">
                    Cada gesto conta. <br> <span>Comece agora.</span>
                </h2>
                <p class="inicio-p">Não importa o tamanho da contribuição - seja com tempo, recursos ou habilidades - você pode transformar vidas hoje.</p>
            </div>
            <div class="botoes-hero">
                <a href="/login" class="btn-voluntario">
                    <img class="coracao-icone" src="/imagem/coracao.png" alt="">
                    Quero Ser Voluntário
                </a>
                <a href="#ongs" class="btn-explorar">
                    Explorar ONGs <span class="seta">→</span>
                </a>
            </div>
        </main>
    </section>

    <section class="causas" id="tela-causas">
        <div class="texto-causas">
            <h2>Encontre sua <span>causa</span></h2>
            <p>Escolha a área que mais se identifica e descubra as ONGs que estão fazendo a diferença</p>
        </div>

        <div class="grid-causas">
            <div class="card">
                <div class="img-container"><img src="/imagem/educacao_img.png" alt="Educação"></div>
                <p>Educação</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/saude_img.png" alt="Saúde"></div>
                <p>Saúde</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/ambiente_img.png" alt="Meio Ambiente"></div>
                <p>Meio Ambiente</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/moradia_img.png" alt="Moradia"></div>
                <p>Moradia</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/seguranca_img.png" alt="Direitos Humanos"></div>
                <p>Direitos Humanos</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/cultura_img.png" alt="Cultura"></div>
                <p>Cultura</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/alimentacao.png" alt="Alimentação"></div>
                <p>Alimentação</p>
            </div>
            <div class="card">
                <div class="img-container"><img src="/imagem/animais_img.png" alt="Animais"></div>
                <p>Animais</p>
            </div>
        </div>
    </section>

    <section class="secao-ongs" id="ongs">
        <div class="container-ongs">
            <div class="titulo-ongs">
                <h1>ONGs que <span class="degrade-texto">transformam</span></h1>
                <p>Conheça as organizações verificadas que estão criando impacto real em comunidades por todo o Brasil.</p>
            </div>

            <div class="grid-ongs">
                <% ongs.forEach(function (ong) { %>
                <a href="/ong/<%= ong.slug %>" class="card-ong" aria-label="Ver detalhes de <%= ong.nome %>">
                    <div class="banner-ong" style="background-image: url('<%= ong.imagem %>');">
                        <span class="tag-ong">
                            <img src="/imagem/coracao.png" alt="" class="mini-coracao-tag">
                            <%= ong.categoria %>
                        </span>
                    </div>
                    <div class="info-ong">
                        <h3 class="nome-ong"><%= ong.nome %></h3>
                        <p><%= ong.resumo %></p>
                        <span class="ver-mais">Ver mais <span class="seta">→</span></span>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
    </section>

    <footer class="footer-principal">
        <div class="footer-container">
            <div class="footer-coluna">
                <h3>ConectaMundos</h3>
                <p>Conectando quem quer ajudar a quem precisa. De forma simples e segura, você faz a diferença no mundo.</p>
            </div>

            <div class="footer-coluna">
                <h3>Navegação</h3>
                <ul>
                    <li><a href="#tela-inicio">Início</a></li>
                    <li><a href="#ongs">ONGs Cadastradas</a></li>
                    <li><a href="/cadastro-ong">Cadastrar ONG</a></li>
                    <li><a href="#tela-inicio">Quero Ajudar</a></li>
                </ul>
            </div>

            <div class="footer-coluna">
                <h3>Contato</h3>
                <ul>
                    <li>contato@conectamundo.org</li>
                    <li>(11) 99999-9999</li>
                    <li>Barueri, SP</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 ConectaMundos. Todos os Direitos Reservados</p>
            <p>Transformando intenções em impacto real.</p>
        </div>
    </footer>

    <!-- Barra de Navegação Fixa Inferior -->
    <nav class="nav-bottom" id="nav-menu">
        <ul>
            <li>
                <a href="#tela-inicio">
                    <i class="fa-solid fa-house"></i>
                    <span>Início</span>
                </a>
            </li>
            <li>
                <a href="#tela-causas">
                    <i class="fa-solid fa-hand-holding-heart"></i>
                    <span>Causas</span>
                </a>
            </li>
            <li>
                <a href="#ongs">
                    <i class="fa-solid fa-building-ngo"></i>
                    <span>ONGs</span>
                </a>
            </li>
            <li>
                <a href="/login">
                    <i class="fa-solid fa-user"></i>
                    <span>Login</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Configurações (fonte e tema) -->
    <!-- Na index usa "config-com-nav" para ficar acima da barra inferior -->
    <%- include('../partials/config-painel', { classe: 'config-com-nav' }) %>

    <script src="/js/script.js"></script>
</body>

</html>