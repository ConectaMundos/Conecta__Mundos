<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de ONG - Conecta Mundos</title>
    <link rel="stylesheet" href="/css/config.css">
    <link rel="stylesheet" href="/css/login.css">
    <script src="/js/config.js"></script>
</head>

<body>
    <header>
        <div class="logo">
            <a href="/">
                <img src="/imagem/logo_degrade.png" alt="Logo Conecta Mundos">
            </a>
        </div>
        <div class="navegacao">
            <a href="/login-ong" class="btn-voltar">← Voltar</a>
        </div>
    </header>

    <!-- "main-cadastro" deixa os blocos lado a lado em telas grandes -->
    <main class="main-cadastro">
        <div class="textos">
            <div class="title">
                <h2>Cadastre sua <span>ONG</span></h2>
            </div>
            <p class="subtitulo">Preencha as informações abaixo para cadastrar sua organização na plataforma.</p>
        </div>

        <form class="formulario" action="/cadastro-ong" method="POST" novalidate>
            <fieldset>
                <legend>Informações Básicas</legend>

                <div class="campo">
                    <label for="ong">Nome da ONG</label>
                    <input type="text" id="ong" name="ong" placeholder="Digite aqui..." value="<%= valores.ong || '' %>" required>
                    <% if (erros.ong) { %><span class="erro-campo" role="alert"><%= erros.ong %></span><% } %>
                </div>

                <div class="campo">
                    <label for="descricao">Descreva sua organização</label>
                    <textarea name="descricao" id="descricao" rows="4" placeholder="Descreva a missão e as atividades da sua ONG..." required><%= valores.descricao || '' %></textarea>
                    <% if (erros.descricao) { %><span class="erro-campo" role="alert"><%= erros.descricao %></span><% } %>
                </div>

                <div class="campo">
                    <label for="categoria">Categoria</label>
                    <select name="categoria" id="categoria">
                        <option value="educacao"<%= valores.categoria === 'educacao' ? ' selected' : '' %>>Educação</option>
                        <option value="saude"<%= valores.categoria === 'saude' ? ' selected' : '' %>>Saúde</option>
                        <option value="meio_ambiente"<%= valores.categoria === 'meio_ambiente' ? ' selected' : '' %>>Meio Ambiente</option>
                        <option value="moradia"<%= valores.categoria === 'moradia' ? ' selected' : '' %>>Moradia</option>
                        <option value="direitos_humanos"<%= valores.categoria === 'direitos_humanos' ? ' selected' : '' %>>Direitos Humanos</option>
                        <option value="cultura"<%= valores.categoria === 'cultura' ? ' selected' : '' %>>Cultura</option>
                        <option value="alimentacao"<%= valores.categoria === 'alimentacao' ? ' selected' : '' %>>Alimentação</option>
                        <option value="animais"<%= valores.categoria === 'animais' ? ' selected' : '' %>>Animais</option>
                        <option value="causas_emergenciais"<%= valores.categoria === 'causas_emergenciais' ? ' selected' : '' %>>Causas Emergenciais</option>
                    </select>
                    <% if (erros.categoria) { %><span class="erro-campo" role="alert"><%= erros.categoria %></span><% } %>
                </div>

                <div class="campo">
                    <label for="metrica">Métrica de Impacto</label>
                    <input type="text" id="metrica" name="metrica" placeholder="Ex.: 500 famílias atendidas" value="<%= valores.metrica || '' %>">
                    <% if (erros.metrica) { %><span class="erro-campo" role="alert"><%= erros.metrica %></span><% } %>
                </div>
            </fieldset>

            <fieldset>
                <legend>Contato e Localização</legend>

                <div class="campo">
                    <label for="email">E-mail de contato</label>
                    <input type="email" id="email" name="email" placeholder="email.contato@ong.org" value="<%= valores.email || '' %>" required>
                    <% if (erros.email) { %><span class="erro-campo" role="alert"><%= erros.email %></span><% } %>
                </div>

                <div class="campo">
                    <label for="telefone">Telefone</label>
                    <input type="tel" id="telefone" name="telefone" placeholder="(00) 00000-0000" value="<%= valores.telefone || '' %>" required>
                    <% if (erros.telefone) { %><span class="erro-campo" role="alert"><%= erros.telefone %></span><% } %>
                </div>

                <div class="campo">
                    <label for="site">Website</label>
                    <input type="url" id="site" name="site" placeholder="https://www.suaong.org" value="<%= valores.site || '' %>">
                    <% if (erros.site) { %><span class="erro-campo" role="alert"><%= erros.site %></span><% } %>
                </div>

                <div class="campo">
                    <label for="endereco">Endereço</label>
                    <input type="text" id="endereco" name="endereco" placeholder="Rua, número, bairro" value="<%= valores.endereco || '' %>">
                    <% if (erros.endereco) { %><span class="erro-campo" role="alert"><%= erros.endereco %></span><% } %>
                </div>

                <div class="linha-dupla">
                    <div class="campo">
                        <label for="estado">Estado</label>
                        <select name="estado" id="estado">
                            <option value="SP"<%= valores.estado === 'SP' ? ' selected' : '' %>>São Paulo</option>
                            <option value="RJ"<%= valores.estado === 'RJ' ? ' selected' : '' %>>Rio de Janeiro</option>
                            <option value="MG"<%= valores.estado === 'MG' ? ' selected' : '' %>>Minas Gerais</option>
                            <option value="ES"<%= valores.estado === 'ES' ? ' selected' : '' %>>Espírito Santo</option>
                        </select>
                        <% if (erros.estado) { %><span class="erro-campo" role="alert"><%= erros.estado %></span><% } %>
                    </div>

                    <div class="campo">
                        <label for="cidade">Cidade</label>
                        <input type="text" id="cidade" name="cidade" placeholder="Digite sua cidade" value="<%= valores.cidade || '' %>">
                        <% if (erros.cidade) { %><span class="erro-campo" role="alert"><%= erros.cidade %></span><% } %>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Engajamento e Acesso</legend>

                <div class="campo">
                    <label for="doacoes">É possível fazer doações recorrentes (mensais)?</label>
                    <input type="text" id="doacoes" name="doacoes" placeholder="Ex.: Sim, via PIX ou cartão" value="<%= valores.doacoes || '' %>">
                    <% if (erros.doacoes) { %><span class="erro-campo" role="alert"><%= erros.doacoes %></span><% } %>
                </div>

                <div class="campo">
                    <label for="voluntarios">Como os voluntários podem sugerir ideias ou melhorias?</label>
                    <textarea name="voluntarios" id="voluntarios" rows="4" placeholder="Responda aqui..."><%= valores.voluntarios || '' %></textarea>
                    <% if (erros.voluntarios) { %><span class="erro-campo" role="alert"><%= erros.voluntarios %></span><% } %>
                </div>

                <div class="campo">
                    <label for="resultados">Quais resultados os voluntários ajudam a alcançar?</label>
                    <textarea name="resultados" id="resultados" rows="4" placeholder="Responda aqui..."><%= valores.resultados || '' %></textarea>
                    <% if (erros.resultados) { %><span class="erro-campo" role="alert"><%= erros.resultados %></span><% } %>
                </div>

                <div class="campo">
                    <label for="senha">Crie uma senha de acesso para a ONG</label>
                    <input type="password" id="senha" name="senha" placeholder="Digite sua senha..." required>
                    <% if (erros.senha) { %><span class="erro-campo" role="alert"><%= erros.senha %></span><% } %>
                </div>
            </fieldset>

            <div class="botao">
                <button type="submit" class="entrar">Cadastrar</button>
            </div>
        </form>
    </main>

    <footer></footer>

    <!-- Configurações (fonte e tema) -->
    <%- include('../partials/config-painel', { classe: '' }) %>
</body>

</html>